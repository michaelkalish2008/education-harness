{
  "$schema": "https://agent-plugins.org/schemas/1.0.0/mcp.schema.json",
  "mcpServers": {
    "education-harness": {
      "type": "stdio",
      "command": "uv",
      "args": ["run", "--project", "${PLUGIN_ROOT}/mcp", "eh-mcp"],
      "cwd": "${PLUGIN_ROOT}",
      "env": {
        "EH_WORKSPACE": "${HOME}/learning"
      }
    }
  }
}
