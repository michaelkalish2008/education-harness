{
  "description": "Best-effort guard: solutions are revealed through the harness tools, and protected files change only through them.",
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "Read|Grep|Glob|LS|NotebookRead|Edit|Write|MultiEdit|NotebookEdit|Bash",
        "hooks": [
          {
            "type": "command",
            "command": "python3 \"${CLAUDE_PLUGIN_ROOT}/hooks/guard.py\""
          }
        ]
      }
    ]
  }
}
